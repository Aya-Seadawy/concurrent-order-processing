{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=orders.db;Default Timeout=5"
  },
  "Notifications": {
    "FakeDelivery": {
      "FailUntilAttempt": 0
    },
    "Worker": {
      "PollIntervalMs": 1000,
      "BatchSize": 10,
      "MaxAttempts": 5,
      "BaseBackoffSeconds": 2,
      "ClaimLeaseSeconds": 30
    }
  }
}
